# ── Project identity ────────────────────────────────────────────────────────
VITE_APP_NAME="RasterForge"
VITE_APP_LOGO_URL=
VITE_APP_COPYRIGHT="© 2026 RasterForge"

# ── Default map view (Seoul; the preview refits to each raster's bounds) ────
VITE_MAP_CENTER_LAT=37.5665
VITE_MAP_CENTER_LON=126.9780
VITE_MAP_ZOOM=13

# ── Backend ─────────────────────────────────────────────────────────────────
# 9010, not 9005 — another lab service already owns 9005 on this machine.
VITE_API_BASE_URL=http://localhost:9010
VITE_WEBSOCKET_URL=ws://localhost:9010/ws

# ── Published tile endpoint (must match backend TILE_PUBLIC_BASE) ───────────
VITE_TILE_PUBLIC_BASE=http://localhost:9010/tiles

# ── Basemap under the generated tiles ───────────────────────────────────────
# OpenStreetMap is the keyless default, so the preview always has context.
# Supplying a VWorld key swaps in Korean satellite imagery instead, which is
# usually the better backdrop for an orthomosaic.
# Register at https://www.vworld.kr/. Restart the dev server after changing
# this — Vite inlines VITE_* at startup.
VITE_VWORLD_API_KEY=

# ── Closed-network proxy ────────────────────────────────────────────────────
VITE_USE_PROXY=false
VITE_PROXY_BASE_URL=

# ── Ortho tile server (unused by RasterForge — it serves its own tiles) ─────
VITE_ORTHO_TILE_BASE_URL=/2Dtile
VITE_ORTHO_TILE_UPSTREAM=http://14.54.13.66:9000
VITE_ORTHO_TILE_BASE_URL_DEV=http://14.54.13.66:9090/2Dtile

# ── Auth (real backend login; the PRD requires authentication) ──────────────
VITE_AUTH_ENABLED=true
VITE_DEMO_MODE=false
