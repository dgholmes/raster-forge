# =============================================================================
# RasterForge frontend — build the SPA, serve it with Nginx.
# =============================================================================
FROM node:22-alpine AS build

WORKDIR /app
COPY rf-frontend/package*.json ./
RUN npm ci

COPY rf-frontend/ ./
# Vite inlines VITE_* at build time, so the API and tile URLs must be known
# here, not at runtime.
ARG VITE_API_BASE_URL=http://localhost:9010
ARG VITE_TILE_PUBLIC_BASE=http://localhost:9010/tiles
ARG VITE_VWORLD_API_KEY=
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_TILE_PUBLIC_BASE=$VITE_TILE_PUBLIC_BASE \
    VITE_VWORLD_API_KEY=$VITE_VWORLD_API_KEY \
    VITE_AUTH_ENABLED=true \
    VITE_DEMO_MODE=false
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /var/www/rasterforge
# Rendered to /etc/nginx/conf.d/default.conf at container start by the nginx
# image's envsubst hook. NGINX_ENVSUBST_FILTER limits substitution to RF_*
# variables so nginx's own $host / $uri / $slug are left untouched.
# RF_API_UPSTREAM defaults to the Compose service name; 127.0.0.1 here would
# point at this container, not the API.
COPY infra/nginx/rasterforge.conf.template /etc/nginx/templates/default.conf.template
ENV RF_API_UPSTREAM=api:9010
ENV NGINX_ENVSUBST_FILTER=^RF_
RUN mkdir -p /var/cache/nginx/rasterforge
EXPOSE 80
