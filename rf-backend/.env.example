# Copy to .env and adjust. Every value has a working development default, so
# the backend runs without a .env at all — this documents what you can override.

# --- Secrets (CHANGE THESE IN PRODUCTION) ---
SECRET_KEY=dev-secret-change-me
JWT_SECRET_KEY=dev-jwt-secret-change-me
JWT_ACCESS_TOKEN_EXPIRES_HOURS=8

# --- Database ---
# SQLite by default. Point at PostgreSQL when you outgrow it; no code changes.
# DATABASE_URL=postgresql+psycopg://rasterforge:secret@localhost/rasterforge
DATABASE_URL=sqlite:///rasterforge.db

# --- CORS (comma-separated origins, or * for all) ---
CORS_ORIGINS=*

# --- Storage ---
# Root of the dataset tree. In production, the volume Nginx also mounts.
# STORAGE_ROOT=/data/rasterforge

# --- Tile publishing ---
# The base URL RasterForge advertises generated pyramids at. This is exactly
# what the UI's "Copy URL" hands the user, so it must be reachable by whoever
# consumes the tiles — not localhost, in production.
TILE_PUBLIC_BASE=http://localhost:9010/tiles

# --- GDAL ---
# Discovery finds QGIS and OSGeo4W automatically; set these only to override.
#
# IMPORTANT (Windows): gdal2tiles ships with QGIS, NOT with OSGeo4W. The
# gdal2tiles.exe wrapper also crashes when launched directly, so RasterForge
# runs it as `<qgis>/apps/Python3xx/python.exe -m osgeo_utils.gdal2tiles`.
# Point GDAL_ROOT at a QGIS install root if auto-discovery picks the wrong one.
# GDAL_ROOT=C:\Program Files\QGIS 3.42.2
# GDAL2TILES_PATH=
GDAL2TILES_PROCESSES=2

# --- Resource protection ---
MAX_UPLOAD_MB=8192
MAX_RASTER_PIXELS=6000000000
MAX_CONCURRENT_RASTER_JOBS=2
MIN_FREE_DISK_GB=10
JOB_TIMEOUT_MINUTES=240

# --- Queue ---
# 'thread' is the in-process bounded pool (default, no external service).
QUEUE_BACKEND=thread
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# DEMO_MODE accepts ANY credentials. Never enable it in production.
DEMO_MODE=0
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@rasterforge.local

# --- Server ---
# 9010, not 9005 — 9005 is already used by another service on the lab machine.
PORT=9010
FLASK_DEBUG=1
SERVICE_NAME=rasterforge
